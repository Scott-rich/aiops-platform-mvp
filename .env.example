# Empty values run explicit heuristic fallback; never claim an LLM was called.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Limits apply to real requests, including retries. A timeout is not retried
# because a provider may already have processed/billed the request.
LLM_TIMEOUT_SECONDS=20
LLM_TOTAL_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_MAX_CALLS_PER_INCIDENT=2
LLM_REQUESTS_PER_MINUTE=10
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_RESPONSE_BYTES=1000000
LLM_MAX_CONTEXT_RECORDS=48
LLM_MAX_CONTEXT_BYTES=64000
LLM_MAX_TOKENS=1500
# none / json_object / json_schema; enable only if your provider supports it.
LLM_RESPONSE_FORMAT=none
# analysis-v2 preserves the provider-facing schema; evidence-selection-v1 uses
# short evidence keys and platform-verified observations (recommended for local Qwen).
LLM_OUTPUT_PROTOCOL=analysis-v2
# Explicit opt-in to HTTP_PROXY/HTTPS_PROXY and other httpx environment settings.
LLM_TRUST_ENV=false
# Optional provider prices; absent usage or prices means cost remains unknown.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_COST_CURRENCY=USD
# For a local compatible inference server, use its base URL ending /v1.
# Containers cannot reach host services through localhost; configure a reachable URL.
# If total timeout exceeds 35s, increase the worker stop_grace_period above it.

# Phase 4: fixed preserves previous rules; dynamic uses causal median/MAD.
# Fast consecutive-5xx warnings are an independent safety lane in both modes.
# Dynamic parameters below do not change legacy fixed thresholds.
DETECTION_MODE=fixed
DETECTION_MIN_REQUESTS=20
DETECTION_MIN_HOSTS=3
DETECTION_MIN_WINDOWS=12
DETECTION_HISTORY_WINDOWS=120
# UTC hour bucket; must divide 24. Each bucket warms up independently.
DETECTION_BUCKET_HOURS=6
DETECTION_MAX_AGE_MS=604800000
DETECTION_SIGMA=3.0
DETECTION_RELATIVE_MARGIN=0.2
DETECTION_LATENCY_MARGIN_MS=50.0
DETECTION_ERROR_MARGIN=0.05
DETECTION_CPU_MARGIN=5.0
DETECTION_MEMORY_MARGIN=5.0
# Local sidecar capacity; Flink uses per-service keyed state with TTL.
DETECTION_MAX_SERVICES=256

# Phase5: local simulator controls only. Resource workers have no remote API.
SIMULATOR_CONTROL_TOKEN=
SIMULATOR_DOWNSTREAM_TIMEOUT_SECONDS=3
# Optional absolute audit directory; local_platform defaults to DATA_DIR/fault-audit.
# Compose simulator audit files reside in /tmp/aiops-fault-audit (container lifetime).
# SIMULATOR_FAULT_AUDIT_DIR=/absolute/path/to/fault-audit

# Phase7: finite storage waits/retries and bounded durable fast-detector keys.
DB_TIMEOUT_SECONDS=3
WORKER_STORAGE_ATTEMPTS=3
FAST_STATE_MAX_KEYS=512
# Kafka connection/poll budgets are per process. Service supervisors may restart it.
WORKER_CONNECT_ATTEMPTS=12
WORKER_POLL_FAILURES=5
WORKER_COMMIT_TIMEOUT_MS=15000

# Phase 8: full evidence capture/verification deadline; raw retention is CLI-only
EVIDENCE_OPERATION_TIMEOUT_SECONDS=30
EVIDENCE_RETENTION_DAYS=30

# Phase 9: worker log level. API/access log configuration remains Uvicorn-managed.
LOG_LEVEL=INFO

# Phase 10: local mode requires a trusted isolated host; token mode protects API routes.
# Tokens must be distinct, 32..512 URL-safe characters. Never put real tokens here.
API_AUTH_MODE=local
API_READ_TOKEN=
API_CONTROL_TOKEN=
TELEMETRY_INGEST_TOKEN=
LOG_FORMAT=json
API_BODY_TIMEOUT_SECONDS=5
LOCAL_READY_MAX_AGE_SECONDS=10

# Self-observation and bounded direct-client-IP token buckets.
API_RATE_PER_SECOND=2000
API_RATE_BURST=10000
API_RATE_MAX_KEYS=10000
API_LEGACY_GET_REDIRECT=0
